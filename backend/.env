# Port du serveur
PORT=5000

# MongoDB - CHANGE CETTE LIGNE SELON TON INSTALLATION
MONGODB_URI=mongodb://localhost:27017/restaurant-delivery

# JWT Secret
JWT_SECRET=votre_secret_key_tres_securisee_changez_la_en_production_123456789

# JWT Expiration
JWT_EXPIRES_IN=7d

# CORS Origin (Frontend URL)
FRONTEND_URL=http://localhost:5173

# Node Environment
NODE_ENV=development
